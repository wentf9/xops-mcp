[Unit]
Description=XOps MCP and administration console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xops-mcp
Group=xops-mcp
ExecStart=/usr/local/bin/xops-mcp serve --config /etc/xops-mcp/server.yaml
Restart=on-failure
RestartSec=3s
TimeoutStopSec=60s
UMask=0077
StateDirectory=xops-mcp
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xops-mcp
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
